# Godot 4+ specific ignores
.godot/
/android/

# Asistentes de IA (reglas, MCP, borradores)
.cursor/
.claude/
.windsurf/
.continue/
.aider/
.agents/
.codex/
agent-transcripts/
.mcp.json
.revision/
addons/godot_mcp/
docs/bitacora/*
!docs/bitacora/GauchoZenon-Bitacora.pdf

# Notas en Markdown: contexto del asistente, bitácora y README
*.md
*.mdc

# Fotos de referencia para crear assets (no forman parte del juego)
referencias/fotos/

# Generador de imagenes de referencia (claves y salidas)
.env
API_KEYS.md
art_source/referencias_generadas/
.env.example

# Copias automáticas de Blender y grabaciones del Movie Maker de Godot
*.blend1
test.avi

# Descargas crudas de Mixamo: la carpeta tiene .gdignore y Godot ya no la importa.
# Los .import y las texturas _0.png que dejaba al lado de cada FBX no sirven para nada.
assets/personajes/animaciones/*.import
assets/personajes/animaciones/*_0.png
graphify-out/
