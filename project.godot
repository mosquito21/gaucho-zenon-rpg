; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ambientcg]

extract_path="res://AmbientCG/Downloads"
material_file_directory="res://AmbientCG/Materials"
environment_file_directory="res://AmbientCG/Environments"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GauchoZenonRPG"
run/main_scene="uid://dm2rhyxcsb061"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ManejadorMusica="*res://scripts/ManejadorMusica.gd"
MCPScreenshot="*res://addons/godot_mcp/mcp_screenshot_service.gd"
MCPInputService="*res://addons/godot_mcp/mcp_input_service.gd"
MCPGameInspector="*res://addons/godot_mcp/mcp_game_inspector_service.gd"
Historia="*res://scripts/Historia.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[editor]

movie_writer/movie_file="F:/Proyectos GODOT/GauchoZenonRPG/gaucho-zenon-rpg/test.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/ambientcg/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

[filesystem]

import/blender/enabled=false

